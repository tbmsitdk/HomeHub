# Arlo credentials
ARLO_EMAIL=your@email.com
ARLO_PASSWORD=yourpassword

# 2FA method: push (approve on phone), imap (reads from email), or skip (if 2FA disabled)
ARLO_TFA_TYPE=push

# Only needed if ARLO_TFA_TYPE=imap
ARLO_IMAP_HOST=imap.gmail.com
ARLO_IMAP_USER=your@email.com
ARLO_IMAP_PASSWORD=your_app_password
