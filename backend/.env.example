# ─── Arlo ────────────────────────────────────────────────────────────────────
# Option A — Session token (recommended, no 2FA headache on every restart)
#   1. Run:  python3 arlo_get_token.py
#   2. Paste the printed token below.
#   Token typically lasts several weeks before expiring.
ARLO_TOKEN=

# Option B — Email + password (only works if 2FA is disabled on your account)
ARLO_EMAIL=your@email.com
ARLO_PASSWORD=yourpassword

# ─── Neotherm ────────────────────────────────────────────────────────────────
# Fill in once you have captured the API using mitmproxy (see capture/ folder).
NEOTHERM_BASE_URL=
NEOTHERM_API_KEY=
